@model Fin_Track.MVC.DTOs.BudgetVMResponseDTO

<h2>Budget Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Limit Amount</th>
        <td>@Model.LimitAmount</td>
    </tr>

    <tr>
        <th>Spent Amount</th>
        <td>@Model.SpentAmount</td>
    </tr>

    <tr>
        <th>Remaining Amount</th>
        <td>@Model.RemainingAmount</td>
    </tr>

    <tr>
        <th>Start Date</th>
        <td>@Model.StartDate.ToShortDateString()</td>
    </tr>

    <tr>
        <th>End Date</th>
        <td>@Model.EndDate.ToShortDateString()</td>
    </tr>

</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>