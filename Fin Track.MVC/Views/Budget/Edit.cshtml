@model Fin_Track.MVC.DTOs.BudgetVMUpdateRequestDTO

<h2>Edit Budget</h2>

<form asp-action="Edit" method="post">

    <input asp-for="BudgetId" type="hidden" />

    <div class="mb-3">
        <label asp-for="LimitAmount"></label>
        <input asp-for="LimitAmount"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate"
               type="date"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Update
    </button>

</form>