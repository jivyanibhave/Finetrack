@model Fin_Track.MVC.DTOs.BudgetVMRequestDTO

<h2>Add Budget</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="LimitAmount"></label>
        <input asp-for="LimitAmount"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate"
               type="date"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

</form>